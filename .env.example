# Yerel geliştirme için kopyalayıp .env yapın (gitignore'da). Boş bırakırsanız yerel SQLite kullanılır.
# Supabase -> Connect -> Transaction pooler adresi (port 6543):
DATABASE_URL=postgresql://postgres.<proje-ref>:<sifre>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Araştırma MVP: varsayılan kapalı. Yerel pilotta DATABASE_URL ve
# RESEARCH_DATABASE_URL boş, LOCAL_DB_PATH ayrı bir SQLite kopyası olmalı.
RESEARCH_API_ENABLED=0
# PostgreSQL aşamasında yalnız lol_research_runtime yetkili ayrı bağlantı;
# mevcut production DATABASE_URL veya Supabase service_role kullanılmaz.
# RESEARCH_DATABASE_URL=

# İsteğe bağlı; yönetici oturumu ve ayrı araştırma deposu gerektirir.
# Görünüm yalnız belirtilen servis kimliğinin raporlarını okur; varsayılan kapalıdır.
RESEARCH_UI_ENABLED=0
# RESEARCH_UI_OWNER=
# Ayrı salt-okunur rol bağlantısı; Bot bağlantısına geri dönüş yapılmaz.
# RESEARCH_UI_DATABASE_URL=

# Zamanlanmış kuyruk köprüsü (python -m app.research_auto; GitHub Actions'ta çalışır,
# Vercel'de gerekmez). RESEARCH_AUTO_IDENTITY=1 seçilen maçı birebir kaynak kimliğiyle
# kaydeder (isim eşleştirme yok). Webhook ikilisi yalnız yeni iş kuyruğa girince
# Grok Bot rutinini tetikler; URL ve anahtar Grok Bot'taki rutin kartından alınır.
# RESEARCH_AUTO_ENABLED=0
# RESEARCH_AUTO_OWNER=
# RESEARCH_AUTO_IDENTITY=0
# RESEARCH_PUBLIC_BASE_URL=https://iddia-oran.vercel.app
# GROK_BOT_WEBHOOK_URL=
# GROK_BOT_WEBHOOK_KEY=
